# =====================================================================
# .env.example - RAG Chatbot BPS Kalteng
# Nama & nilai bawaan dicocokkan dengan KODE (app.py, chat.py, publikasi.py,
# sop.py, common.py). Yang BELUM dilihat: docker-compose.yml, ingest_service.py,
# answer_cache.py -> bila compose Anda meneruskan variabel dengan nama lain,
# sesuaikan. Salin menjadi .env (jangan di-commit).
# Terapkan dengan:  docker compose up -d app   (BUKAN restart)
# docker-compose.yml (versi baru) sudah meneruskan SEMUA variabel di bawah ke
# service `app` dengan pola ${VAR:-bawaan}. Variabel yang tidak ditulis di
# `environment:` compose tidak akan sampai ke container walau ada di .env.
# Nilai kosong diperlakukan sama seperti tidak diset (kecuali dinyatakan lain).
# =====================================================================

# ---------- JARINGAN (docker-compose.yml) ----------
# Bawaan: 5000:5000 (terbuka di semua antarmuka). Di server, bila Hub berjalan
# di mesin yang SAMA, batasi ke lokal: RAG_PORT_BIND=127.0.0.1:5000:5000
RAG_PORT_BIND=5000:5000

# ---------- KEAMANAN (app.py) ----------
# Bearer key untuk /api/ask, ingest, dan dokumen. Buat:  openssl rand -hex 32
# Kosong = /api/ask terbuka dan endpoint ingest/dokumen menjawab 503.
RAG_API_KEY=
# Hanya uji lokal. JANGAN 1 di server.
INGEST_ALLOW_NO_AUTH=0

# ---------- LAYANAN LUAR (chat.py, common.py) ----------
# Bawaan kode: localhost. Di Docker laptop: host.docker.internal.
QDRANT_HOST=host.docker.internal
QDRANT_PORT=6333
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ---------- MODEL TANYA-JAWAB (chat.py) - AMAN diubah kapan saja ----------
# Bawaan kode: qwen2.5:3b-instruct ; fallback qwen2.5:1.5b-instruct.
# Laptop (compose meng-override): hermes3:latest. Server: sesuaikan VRAM.
# Model harus sudah di-pull di Ollama, kalau tidak chatbot jatuh ke fallback.
LLM_MODEL=hermes3:latest
LLM_MODEL_FALLBACK=hermes3:latest
LLM_HEALTHCHECK_TIMEOUT=60

# Jumlah chunk terbaik yang dikirim ke LLM, dan jendela konteks.
# CONTEXT_WINDOW jangan < 4096 (prompt SOP pernah ~4000 token -> Ollama crash).
# Naikkan keduanya HANYA bersama OLLAMA_CONTEXT_LENGTH di sisi Ollama.
TOP_K_FINAL=6
CONTEXT_WINDOW=4096

# ---------- RE-RANKER (chat.py) ----------
# Bawaan: cpu (karena VRAM laptop sempit). Di server ber-GPU lega, 'cuda'
# mempercepat jawaban banyak; pastikan image Docker memang punya torch+CUDA [CEK].
# Ambang di chat.py hanya valid untuk skor logit bge-reranker-v2-m3: setelah
# start, log TIDAK boleh memuat "Aktivasi re-ranker diganti ke Identity".
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=cpu

# ---------- EMBEDDING (chat.py + publikasi.py + sop.py) - BERBAHAYA ----------
# Harus IDENTIK untuk tanya-jawab dan ingest (satu env dibaca ketiganya).
# Mengganti setelah data terisi = seluruh korpus (~136 ribu chunk) di-embed ulang;
# jika tidak, hasil tampak normal tetapi salah. Putuskan SEBELUM upload dibuka.
EMBED_MODEL=nomic-embed-text

# ---------- ANTRIAN PERTANYAAN (app.py) ----------
# Naikkan ASK_MAX_CONCURRENT HANYA bersama OLLAMA_NUM_PARALLEL (sisi Ollama),
# bertahap, sambil memantau /api/health. JANGAN > 1 sebelum
# _LAST_RETRIEVAL_TIMING (global di chat.py) dibuat per-request.
ASK_MAX_CONCURRENT=1
ASK_MAX_WAITING=10
ASK_WAIT_TIMEOUT=90

# ---------- INGEST DOKUMEN (app.py, publikasi.py, sop.py, common.py) ----------
MAX_UPLOAD_MB=100
# Bawaan: folder ingest_data di samping app.py. Letakkan di volume yang di-backup.
INGEST_DATA_DIR=
INGEST_WORKERS=1
INGEST_JOB_TIMEOUT=3600
# 1 = unggahan menunggu persetujuan admin (status MENUNGGU_PERSETUJUAN)
INGEST_REQUIRE_APPROVAL=0
# Model LLM yang dipakai SAAT INGEST (terpisah dari LLM_MODEL). Bawaan: hermes3.
# Harus sudah di-pull di Ollama server.
INGEST_LLM_MODEL=hermes3
# Penyetelan kecepatan ingest; server lebih kuat boleh dinaikkan bertahap.
EMBED_BATCH_SIZE=100
EMBED_CONCURRENCY=3
EXTRACT_WORKERS=4
# [CEK] compose lama punya INGEST_EXTRACT_WORKERS (bawaan 1) yang tidak dibaca kode yang
# sudah saya lihat; dipertahankan di compose. Bila ingest_service.py membacanya, atur di sini:
# INGEST_EXTRACT_WORKERS=1
# OCR untuk PDF scan (common.py). Bawaan: aktif, ind+eng, 200 dpi.
OCR_ENABLED=1
OCR_LANG=ind+eng
OCR_DPI=200

# ---------- SETELAN DI SISI OLLAMA (bukan .env app) ----------
# Diatur di container/service Ollama:
#   OLLAMA_NUM_PARALLEL=1        (laptop) -> naikkan bersama ASK_MAX_CONCURRENT
#   OLLAMA_CONTEXT_LENGTH=4096   (laptop) -> samakan/naikkan bersama CONTEXT_WINDOW
