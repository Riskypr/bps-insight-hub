diff --git a/pb/api/routes/rag.ts b/api/routes/rag.ts
new file mode 100644
index 0000000..af71ea2
--- /dev/null
+++ b/api/routes/rag.ts
@@ -0,0 +1,26 @@
+import { Hono } from "hono";
+import { ragFetch, RagUnavailableError } from "../lib/rag";
+
+const ragRoutes = new Hono();
+// Nama file asli: "<nama pdf SOP>_p<n>.png" -> boleh berisi spasi, kurung, huruf non-ASCII.
+// Yang ditolak: pemisah path (/ \\), karakter kontrol/NUL, awalan titik, ekstensi non-gambar.
+const okName = (n: string) =>
+  n.length > 0 && n.length <= 255 && !/[\/\\\u0000-\u001f]/.test(n) && !n.startsWith(".") && /\.(png|jpe?g|webp)$/i.test(n);
+const MIME: Record<string, string> = { png: "image/png", jpg: "image/jpeg", jpeg: "image/jpeg", webp: "image/webp" };
+
+// Browser pegawai tidak boleh menembak Flask langsung: gambar SOP diteruskan lewat sini.
+ragRoutes.get("/sop-image/:name", async (c) => {
+  const name = c.req.param("name");
+  if (!okName(name)) return c.json({ error: "Nama gambar tidak valid" }, 400);
+  try {
+    const up = await ragFetch(`/static/sop_images/${encodeURIComponent(name)}`, {}, false);
+    if (!up.ok) return c.json({ error: "Gambar tidak ditemukan" }, 404);
+    const ext = name.split(".").pop()!.toLowerCase();
+    return new Response(up.body, { headers: { "Content-Type": up.headers.get("content-type") ?? MIME[ext], "Cache-Control": "public, max-age=86400" } });
+  } catch (e) {
+    if (e instanceof RagUnavailableError) return c.json({ error: "Layanan RAG tidak terjangkau" }, 502);
+    throw e;
+  }
+});
+
+export { ragRoutes };
