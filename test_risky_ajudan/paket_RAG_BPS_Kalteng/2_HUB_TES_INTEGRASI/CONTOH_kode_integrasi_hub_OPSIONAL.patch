diff --git a/pb/api/lib/rag.ts b/api/lib/rag.ts
new file mode 100644
index 0000000..cf53f21
--- /dev/null
+++ b/api/lib/rag.ts
@@ -0,0 +1,133 @@
+// Klien untuk layanan RAG BPS Kalteng (Flask). Kontrak: KONTRAK_API_RAG.md
+// Semua konfigurasi dibaca dari env saat dipanggil (bukan saat modul dimuat).
+
+const cfg = () => ({
+  base: (process.env.RAG_API_BASE ?? "").replace(/\/+$/, ""),
+  key: process.env.RAG_API_KEY ?? "",
+  timeout: Number(process.env.RAG_TIMEOUT_MS ?? 180_000),
+});
+
+export const ragEnabled = () => Boolean(cfg().base);
+
+export class RagBusyError extends Error {
+  constructor(public retryAfter: number) { super("rag_sibuk"); }
+}
+export class RagAuthError extends Error { constructor() { super("rag_auth"); } }
+export class RagUnavailableError extends Error {}
+
+/** fetch ke RAG dengan key + batas waktu. Galat jaringan/timeout -> RagUnavailableError. */
+export async function ragFetch(path: string, init: RequestInit = {}, withKey = true): Promise<Response> {
+  const { base, key, timeout } = cfg();
+  const headers = new Headers(init.headers);
+  if (withKey && key) headers.set("Authorization", `Bearer ${key}`);
+  try {
+    return await fetch(`${base}${path}`, { ...init, headers, signal: AbortSignal.timeout(timeout) });
+  } catch (e) {
+    throw new RagUnavailableError(e instanceof Error ? e.message : String(e));
+  }
+}
+
+export type RagAnswer = {
+  mode: string; answer: string; warning?: string | null; note?: string | null;
+  sources?: { title?: string; pages?: string[]; cited_pages?: string[] }[];
+  featured_image?: { url: string; page?: string; title?: string } | null;
+};
+
+export async function ragAsk(question: string): Promise<RagAnswer> {
+  const res = await ragFetch("/api/ask", {
+    method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ question }),
+  });
+  if (res.status === 503) {
+    const j = (await res.json().catch(() => ({}))) as { error?: string; retry_after?: number };
+    if (j.error === "server_sibuk") throw new RagBusyError(Number(j.retry_after) || 30);
+    throw new RagUnavailableError("RAG belum siap");
+  }
+  if (res.status === 401) throw new RagAuthError();
+  if (!res.ok) throw new RagUnavailableError(`RAG ${res.status}`);
+  return (await res.json()) as RagAnswer;
+}
+
+/** Pertanyaan = teks pesan pengguna TERAKHIR (RAG belum punya riwayat percakapan). */
+export function extractQuestion(body: {
+  message?: string;
+  messages?: { role: string; content: string | { type: string; text?: string }[] }[];
+}): string {
+  if (body.messages?.length) {
+    const last = [...body.messages].reverse().find((m) => m.role === "user");
+    if (last) {
+      if (typeof last.content === "string") return last.content.trim();
+      return last.content.filter((p) => p.type === "text").map((p) => p.text ?? "").join("\n").trim();
+    }
+  }
+  return (body.message ?? "").trim();
+}
+
+const IMAGE_PREFIX = () => `${process.env.PUBLIC_API_PREFIX ?? "/api"}/rag/sop-image/`;
+
+/** Ubah jawaban RAG menjadi markdown untuk chat. Bullet '- ' diganti '* ' (lihat extractSuggestions). */
+export function formatRagAnswer(r: RagAnswer): string {
+  const parts: string[] = [];
+  parts.push(r.answer.replace(/^(\s*)-\s/gm, "$1* "));
+  if (r.warning) parts.push(`**Peringatan:** ${r.warning}`);
+  if (r.note) parts.push(`*${r.note}*`);
+  if (r.featured_image?.url) {
+    const name = r.featured_image.url.split("/").pop() ?? "";
+    const block = { url: `${IMAGE_PREFIX()}${name}`, alt: r.featured_image.title ?? "Halaman SOP",
+      caption: `${r.featured_image.title ?? "SOP"}${r.featured_image.page ? `, halaman ${r.featured_image.page}` : ""}` };
+    parts.push("```image\n" + JSON.stringify(block) + "\n```");
+  }
+  const titles = (r.sources ?? []).filter((s) => s.title);
+  if (titles.length) {
+    parts.push("**Sumber:**\n" + titles.map((s) => `* ${s.title}${s.pages?.length ? ` (hlm ${s.pages.join(", ")})` : ""}`).join("\n"));
+  }
+  return parts.join("\n\n");
+}
+
+/** Jawaban RAG (utuh) dikirim sebagai SSE format OpenAI supaya parser frontend tidak berubah. */
+export function ragSseResponse(text: string, conversationId: string): Response {
+  const enc = new TextEncoder();
+  const stream = new ReadableStream({
+    start(controller) {
+      controller.enqueue(enc.encode(`data: ${JSON.stringify({ conversationId })}\n\n`));
+      for (let i = 0; i < text.length; i += 60) {
+        controller.enqueue(enc.encode(`data: ${JSON.stringify({ choices: [{ delta: { content: text.slice(i, i + 60) } }] })}\n\n`));
+      }
+      controller.enqueue(enc.encode("data: [DONE]\n\n"));
+      controller.close();
+    },
+  });
+  return new Response(stream, { headers: { "Content-Type": "text/event-stream", "Cache-Control": "no-cache", Connection: "keep-alive" } });
+}
+
+export type IngestOutcome = {
+  hubStatus: "SUCCESS" | "SKIPPED" | "FAILED";
+  storeLocally: boolean;
+  reason?: string;
+  fields: { ragJobId?: string; ragStatus: string; existingChunks?: number };
+};
+
+/** Teruskan 1 PDF ke /api/ingest (nama asli dipertahankan) dan terjemahkan hasilnya untuk Hub. */
+export async function ragIngest(o: { name: string; content: Uint8Array; title?: string; uploader?: string; replace?: boolean }): Promise<IngestOutcome> {
+  const fd = new FormData();
+  fd.append("file", new File([o.content], o.name, { type: "application/pdf" }));
+  if (o.title) fd.append("title", o.title);
+  if (o.uploader) fd.append("uploader", o.uploader);
+  if (o.replace) fd.append("replace", "true");
+  let res: Response;
+  try {
+    res = await ragFetch("/api/ingest", { method: "POST", body: fd });
+  } catch {
+    return { hubStatus: "SUCCESS", storeLocally: true, fields: { ragStatus: "UNAVAILABLE" } };
+  }
+  const j = (await res.json().catch(() => ({}))) as Record<string, any>;
+  if (res.status === 202) return { hubStatus: "SUCCESS", storeLocally: true, fields: { ragJobId: j.job_id, ragStatus: j.status ?? "PENDING" } };
+  if (res.status === 200 && j.status === "SKIPPED")
+    return { hubStatus: "SKIPPED", storeLocally: false, reason: j.catatan || "Dilewati: bukan publikasi/SOP BPS Kalteng", fields: { ragJobId: j.job_id, ragStatus: "SKIPPED" } };
+  if (res.status === 409 && j.existing_job_id)
+    return { hubStatus: "SKIPPED", storeLocally: false, reason: "Dokumen identik sudah ada di chatbot", fields: { ragJobId: j.existing_job_id, ragStatus: "DUPLICATE" } };
+  if (res.status === 409)
+    return { hubStatus: "FAILED", storeLocally: false, reason: "Nama file sudah ada di chatbot; kirim ulang dengan replace untuk mengganti versi", fields: { ragStatus: "NAME_CONFLICT", existingChunks: j.existing_chunks } };
+  if (res.status === 401) return { hubStatus: "FAILED", storeLocally: false, reason: "Key layanan RAG ditolak", fields: { ragStatus: "AUTH_ERROR" } };
+  if (res.status >= 400 && res.status < 500) return { hubStatus: "FAILED", storeLocally: false, reason: j.error ?? "Ditolak layanan RAG", fields: { ragStatus: "REJECTED" } };
+  return { hubStatus: "SUCCESS", storeLocally: true, fields: { ragStatus: "UNAVAILABLE" } };
+}
