# ── AI Chat Completion API ──
AI_API_BASE=http://localhost:20128/v1
AI_API_MODEL=default
AI_API_KEY=

# ── App ──
VITE_APP_TITLE=BPS AI Assistant

# ── PDF management / PostgreSQL (Supabase Connection Pooler) ──
# DATABASE_URL  → pooler (Transaction mode, port 6543) — untuk runtime app
# Karakter spesial di password wajib di-URL-encode: @ → %40  ! → %21
DATABASE_URL="postgresql://postgres."

# DIRECT_URL → koneksi langsung (non-pooler, port 5432) — untuk prisma db push / migrate
DIRECT_URL="postgresql://postgres."

# â”€â”€ PDF management / PostgreSQL â”€â”€
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bps_insight_hub?schema=public"
PDF_STORAGE_DIR=.storage/pdfs
PDF_MAX_FILE_SIZE_BYTES=26214400
PDF_BOT_API_KEY=replace-with-a-long-random-server-token
FRONTEND_ORIGIN=http://localhost:5173
