# ── Python LLM & RAG Backend (chat.py) ──
CHAT_PY_URL=http://localhost:5000
PYTHON_BACKEND_URL=http://localhost:5000

# ── Legacy AI Chat Completion API (opsional/cadangan) ──
AI_API_BASE=http://localhost:20128/v1
AI_API_MODEL=default
AI_API_KEY=

# ── App ──
VITE_APP_TITLE=BPS AI Assistant

# ── PDF management / PostgreSQL (Supabase Connection Pooler) ──
# DATABASE_URL  → pooler (Transaction mode, port 6543) — untuk runtime app
# Karakter spesial di password wajib di-URL-encode: @ → %40  ! → %21
DATABASE_URL="postgresql://postgres.YOURPROJECT:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL → koneksi langsung (non-pooler, port 5432) — untuk prisma db push / migrate
DIRECT_URL="postgresql://postgres.YOURPROJECT:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# ── PDF Storage ──
PDF_STORAGE_DIR=.storage/pdfs
PDF_MAX_FILE_SIZE_BYTES=26214400
PDF_BOT_API_KEY=replace-with-a-long-random-server-token

# ── CORS (hanya dipakai jika FE & BE berjalan di port berbeda) ──
FRONTEND_ORIGIN=http://localhost:5173
